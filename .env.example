# Speech-to-text engine: whisper (real, faster-whisper) | mock (offline, deterministic)
AUDIO_DECODER_BACKEND=whisper
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
AUDIO_DECODER_WHISPER_MODEL=small
# cpu | cuda
AUDIO_DECODER_WHISPER_DEVICE=cpu
# int8 for CPU, float16 for GPU
AUDIO_DECODER_WHISPER_COMPUTE=int8

AUDIO_DECODER_DATA_DIR=./data
# concurrent jobs, and concurrent chunks within a job.
# Each running job holds its decoded audio in RAM (~115 MB per audio hour), so for
# 3-hour files budget ~350 MB per worker plus the model.
AUDIO_DECODER_WORKERS=2
AUDIO_DECODER_CHUNK_WORKERS=2
# queued + processing jobs allowed before uploads get 429 (bounds disk: ~this * MAX_UPLOAD_MB)
AUDIO_DECODER_MAX_PENDING_JOBS=100
AUDIO_DECODER_MAX_UPLOAD_MB=200
AUDIO_DECODER_MAX_DURATION_S=10800
AUDIO_DECODER_MAX_RETRIES=3
AUDIO_DECODER_REDACT_PII=true
# leave empty to disable auth in local development
AUDIO_DECODER_API_KEY=
# only for BACKEND=mock: path to a timed script (see examples/demo_call.script.json)
AUDIO_DECODER_MOCK_SCRIPT=
